<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup rules.

  android:fullBackupContent only configures cloud backups on API 31+ and does
  not cover device-to-device transfers, so the EasyTier files must be excluded
  again here.  The excluded files are:

  - easytier_secret.xml: the Keystore-bound store for the network secret.
  - easytier_config.json / easytier_status.json / easytier_last_routes.json:
    peer URIs (possibly with credentials), mesh topology and the routing
    baseline.  They are transient and can be regenerated from settings.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="easytier_secret.xml" />
        <exclude domain="file" path="easytier_config.json" />
        <exclude domain="file" path="easytier_status.json" />
        <exclude domain="file" path="easytier_last_routes.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="easytier_secret.xml" />
        <exclude domain="file" path="easytier_config.json" />
        <exclude domain="file" path="easytier_status.json" />
        <exclude domain="file" path="easytier_last_routes.json" />
    </device-transfer>
</data-extraction-rules>